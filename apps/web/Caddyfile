:80 {
	root * /usr/share/caddy

	@notify path /api/notify /api/notify/*
	handle @notify {
		reverse_proxy http://{$NOTIFY_BACKEND:notifier:8080} {
			header_up Host {host}
		}
	}

	@cookie path /api/cookie /api/cookie/*
	handle @cookie {
		reverse_proxy http://{$COOKIE_BACKEND:cookie:8080} {
			header_up Host {host}
		}
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy http://{$API_BACKEND:backend:8080} {
			header_up Host {host}
		}
	}

	@static path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg
	handle @static {
		header Cache-Control "public, max-age=31536000, immutable"
		try_files {path}
		file_server
	}

	handle {
		try_files {path} {path}/ /index.html
		file_server
	}
}
