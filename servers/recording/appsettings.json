{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Recording": {
    "StorageDir": "/data/recordings",
    "PollIntervalSeconds": 30,
    "LockTtlSeconds": 15,
    "LockRenewIntervalSeconds": 5,
    "FencingIntervalMilliseconds": 2000,
    "AudioBufferBytes": 262144,
    "DefaultBitrateKbps": 4000,
    "ProbeBitrate": true,
    "FfprobePath": "ffprobe",
    "FfmpegPath": "ffmpeg",
    "Referer": "https://live.bilibili.com/",
    "UserAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36",
    "Av1": {
      "Enabled": true
    }
  }
}
