{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BilibiliCrawler": {
    "StatusIntervalSeconds": 15,
    "SpaceTimelineIntervalSeconds": 30,
    "AccountInfoIntervalHours": 24,
    "CookieProbeIntervalMinutes": 5,
    "FetchMode": "Auto",
    "BackoffBaseSeconds": 30,
    "BackoffMaxMinutes": 15,
    "CooldownMinutes": 30,
    "RiskControlCooldownThreshold": 5,
    "BrowserMinDelaySeconds": 2,
    "BrowserMaxDelaySeconds": 5,
    "BrowserUserAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
    "ChannelRecoverSuccessCount": 3
  },
  "WeiboCrawler": {
    "TimelineIntervalSeconds": 60,
    "HttpTimeoutSeconds": 10,
    "CookieRefreshIntervalMinutes": 60,
    "MaxPagesPerCrawl": 5,
    "UserAgent": "Mozilla/5.0 (iPhone; CPU iPhone OS 16_6 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/16.6 Mobile/15E148 Safari/604.1",
    "BackoffBaseSeconds": 30,
    "BackoffMaxMinutes": 15,
    "CooldownMinutes": 30,
    "RiskControlCooldownThreshold": 5
  }
}
